{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BSI Response Schema",
  "description": "پاسخ تحلیل شاخص بهمنش",
  "type": "object",
  "properties": {
    "success": { "type": "boolean" },
    "version": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "integrity_level": {
      "type": "string",
      "enum": ["HIGH_INTEGRITY", "MODERATE_INTEGRITY", "LOW_INTEGRITY", "CRITICAL_GAPS"]
    },
    "core_claim": { "type": "string" },
    "scores": {
      "type": "object",
      "properties": {
        "ConditionalDepth": { "type": "number" },
        "LongitudinalCoherence": { "type": "number" },
        "AuthenticEthicalLayer": { "type": "number" },
        "CreativeValueAdd": { "type": "number" },
        "StrategicDepth": { "type": "number" },
        "InterdisciplinaryBreadth": { "type": "number" },
        "AntiPerformativeDrift": { "type": "number" }
      }
    },
    "creative_value_add": {
      "type": "object",
      "properties": {
        "EpistemicGapTargeting": { "type": "number" },
        "CombinatorialSynthesis": { "type": "number" },
        "GenerativeCapacity": { "type": "number" }
      }
    },
    "layers": {
      "type": "object",
      "properties": {
        "manifest": { "type": "object" },
        "latent": { "type": "object" },
        "meta": { "type": "object" }
      }
    },
    "eig_score": { "type": "number" },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["success", "overall_score", "integrity_level"]
}
