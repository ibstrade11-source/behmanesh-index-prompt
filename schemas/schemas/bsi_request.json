{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BSI Request Schema",
  "description": "درخواست برای تحلیل و امتیازدهی شاخص بهمنش",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 10,
      "description": "متن اصلی برای تحلیل"
    },
    "pipeline": {
      "type": "boolean",
      "default": true,
      "description": "اجرای Pipeline کامل"
    },
    "detail": {
      "type": "boolean",
      "default": true,
      "description": "بازگشت جزئیات کامل"
    },
    "compare_with": {
      "type": "array",
      "items": { "type": "string" }
    },
    "options": {
      "type": "object",
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "include_eig": { "type": "boolean", "default": true },
        "include_meta": { "type": "boolean", "default": true }
      }
    }
  },
  "required": ["text"],
  "additionalProperties": false
}
